# torrc — Tor1 (used by SearXNG1 for .onion engines)
SocksPort 0.0.0.0:9050
DataDirectory /var/lib/tor
Log notice stdout

# Disable Bridges
UseBridges 0

# ══════════════════════════════════════════════════════════════
# RELIABILITY OPTIMIZATIONS (same as tor2)
# ══════════════════════════════════════════════════════════════

# Multiple guards — prevents single-guard failure cascade
NumEntryGuards 3
UseEntryGuards 1

LearnCircuitBuildTimeout 1
CircuitBuildTimeout 15
CircuitIdleTimeout 120
NewCircuitPeriod 30
MaxClientCircuitsPending 32
SocksTimeout 10
FetchDirInfoEarly 1
FetchDirInfoExtraEarly 1
KeepalivePeriod 60
ConnLimit 1024

# Shared namespace: don't exclude guards from same subnet
EnforceDistinctSubnets 0

# Client-only — never relay
ExitPolicy reject *:*
ExitPolicy reject6 *:*

# Don't prefer IPv6 ORPorts
ClientPreferIPv6ORPort 0

# Reduce overhead
DirCache 0
V3AuthoritativeDirectory 0
