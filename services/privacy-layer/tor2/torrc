# torrc for tor2 — optimized for reliability (SearXNG2 proxy)
SocksPort 0.0.0.0:9051
ControlPort 0.0.0.0:9052
HashedControlPassword 16:B70C1E480C610ED5604D61339FA15016B824A8A0052832441BC893A4FB
DataDirectory /var/lib/tor
Log notice stdout

# Disable Bridges
UseBridges 0

# ══════════════════════════════════════════════════════════════
# RELIABILITY OPTIMIZATIONS (no timeout changes)
# ══════════════════════════════════════════════════════════════

# Multiple guard nodes — redundancy prevents single-guard failure cascade
# (was 1: a single slow/excluded guard broke ALL circuits)
NumEntryGuards 3
UseEntryGuards 1

# Learn and enforce fast circuit build timeout
LearnCircuitBuildTimeout 1
CircuitBuildTimeout 15

# Keep circuits alive longer for reuse (search burst pattern)
CircuitIdleTimeout 120
NewCircuitPeriod 30

# Allow more pending circuits for parallel SearXNG engine requests
MaxClientCircuitsPending 32

# SOCKS connection handling
SocksTimeout 10

# Directory info — fetch early for faster bootstrap
FetchDirInfoEarly 1
FetchDirInfoExtraEarly 1

# Keepalive to prevent circuit teardown
KeepalivePeriod 60

# Connection limits
ConnLimit 1024

# ══════════════════════════════════════════════════════════════
# SHARED NAMESPACE FIXES
# ══════════════════════════════════════════════════════════════

# Don't enforce distinct subnets — all containers share gluetun's netns
# Without this, Tor excludes guards from the same /24 → "path restriction type 2"
EnforceDistinctSubnets 0

# Never act as a relay — this is a client-only instance
ExitPolicy reject *:*
ExitPolicy reject6 *:*

# Don't prefer IPv6 — IPv6 ORPorts cause more connection failures
ClientPreferIPv6ORPort 0

# Reduce directory overhead — we don't need to serve descriptors
DirCache 0
V3AuthoritativeDirectory 0

# Stale consensus detection — prefer fresh consensus
TestingTorNetwork 0
