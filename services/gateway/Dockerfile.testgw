# syntax=docker/dockerfile:1
# Test runner that reuses the gateway's builder stage so `cargo test` inherits
# the warm dependency cache instead of recompiling every crate from scratch.
FROM rust:1.88-slim-bookworm AS t
WORKDIR /usr/src/gateway
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release
COPY src ./src
# Warm the debug test profile too, then run the suite.
RUN touch src/main.rs && cargo test -p gateway --lib --no-run 2>&1 | tail -5
RUN touch src/main.rs && cargo test -p gateway --lib 2>&1 | tail -40
