# syntax=docker/dockerfile:1
# Test runner reusing the gateway's builder stage so `cargo test` inherits the
# warm dependency cache. The crate is a BINARY (no lib target), so we must not
# pass --lib; `cargo test -p gateway` runs the #[cfg(test)] modules in the bin.
FROM rust:1.88-slim-bookworm AS t
WORKDIR /usr/src/gateway
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release
COPY src ./src
RUN touch src/main.rs && cargo test -p gateway --no-run 2>&1 | tail -5
RUN touch src/main.rs && cargo test -p gateway 2>&1 | tail -60
