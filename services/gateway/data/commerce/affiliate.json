{
  "version": 1,
  "note": "Runtime-loaded affiliate network config. Adding a merchant/network requires ONLY editing this file — no recompile. Keys/secrets come from ENVIRONMENT VARIABLES (see key_env / param_env), never hardcoded here. Two template kinds: 'wrap' (network prefix + url-encoded destination, e.g. Sovrn/Skimlinks) and 'append_params' (add query params to the merchant URL, e.g. eBay EPN / Amazon).",
  "eligibility": {
    "note": "Affiliate decoration is permitted only when BOTH (a) the request carries a commercial signal the intent engine already produced (transactional label, transactional distribution, or a parsed price bound) AND (b) the query has the STRUCTURAL SHAPE of an exact product/model designator. Broad product/category searches stay free on both halves. This describes what a model designator looks like — never a per-brand or per-query rule — so monetizing a new product family needs no edit here and no recompile.",
    "model_shape": {
      "min_designator_len": 3,
      "max_number_len": 4,
      "variant_suffixes": [
        "pro", "max", "plus", "mini", "ultra", "se", "air", "lte", "lts", "5g",
        "titanium", "graphite", "silver", "gold", "blue", "black", "white",
        "x", "xl", "xxl", "fe", "lt", "gt", "ti", "xe", "gaming", "plus"
      ],
      "commerce_words": [
        "price", "prices", "cost", "costs", "deal", "deals", "coupon",
        "coupons", "offer", "offers", "buy", "shop", "order", "discount",
        "sale", "cheap", "rate", "in", "india", "usa", "uk"
      ],
      "quantity_markers": [
        "under", "below", "over", "above", "at", "least", "most", "up",
        "down", "within", "around", "near", "between", "max", "min", "less",
        "more", "than", "of", "for", "about", "approx", "only", "just", "per"
      ]
    }
  },
  "networks": [
    {
      "id": "sovrn",
      "kind": "wrap",
      "enabled": true,
      "priority": 100,
      "network": "Sovrn Commerce",
      "template": "https://sovrn.co?key={key}&u={url}",
      "params": { "cuid": "{subid}" },
      "key_env": "SOVRN_COMMERCE_KEY",
      "param_env": {},
      "bid_floor": "0.10",
      "fallback_url": "https://www.example-merchant.com/",
      "bid_check_url": "https://api.viglink.com/api/bid?key={key}&out={url}"
    },
    {
      "id": "skimlinks",
      "kind": "wrap",
      "enabled": true,
      "priority": 90,
      "network": "Skimlinks",
      "template": "https://go.redirectingat.com/?xid={key}&url={url}",
      "params": {},
      "key_env": "SKIMLINKS_XID",
      "param_env": {}
    },
    {
      "id": "ebay_epn",
      "kind": "append_params",
      "enabled": true,
      "priority": 80,
      "network": "eBay Partner Network",
      "template": "{url}",
      "params": {
        "mkevt": "1",
        "mkcid": "1",
        "mkrid": "{key}",
        "campid": "{param:campaign_id}",
        "toolid": "10001",
        "customid": "{subid}"
      },
      "key_env": "EBAY_EPN_ROTATION_ID",
      "param_env": { "campaign_id": "EBAY_EPN_CAMPAIGN_ID" }
    },
    {
      "id": "amazon_associates",
      "kind": "append_params",
      "enabled": true,
      "priority": 70,
      "network": "Amazon Associates",
      "template": "{url}",
      "params": { "tag": "{key}" },
      "key_env": "AMAZON_ASSOCIATES_TAG",
      "param_env": {}
    },
    {
      "id": "rakuten_advertising",
      "kind": "wrap",
      "enabled": true,
      "priority": 60,
      "network": "Rakuten Advertising",
      "template": "https://click.linksynergy.com/deeplink?id={key}&mid={param:merchant_id}&murl={url}",
      "params": {},
      "key_env": "RAKTUEN_LINKSYNERGY_ID",
      "param_env": { "merchant_id": "RAKTUEN_MERCHANT_ID" }
    }
  ]
}
