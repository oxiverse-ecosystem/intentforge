      "params": {},
      "key_env": "CLICKBANK_HOPLINK_ID",
      "param_env": {
        "vendor_id": "CLICKBANK_VENDOR_ID"
      },
      "disclosed": true
    },
    {
      "id": "partnerstack",
      "name": "PartnerStack",
      "network": "PartnerStack",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 25,
      "template": "https://{key}.partnersstack.com/r/{param:partner_id}?url={url}&subId={subid}",
      "params": {},
      "key_env": "PARTNERSTACK_COMPANY_ID",
      "param_env": {
        "partner_id": "PARTNERSTACK_PARTNER_ID"
      },
      "disclosed": true
    },
    {
      "id": "flexoffers",
      "name": "FlexOffers",
      "network": "FlexOffers",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 20,
      "template": "https://track.flexoffers.com/aff_c?offer_id={param:offer_id}&aff_id={key}&url={url}&sub1={subid}",
      "params": {},
      "key_env": "FLEXOFFERS_AFF_ID",
      "param_env": {
        "offer_id": "FLEXOFFERS_OFFER_ID"
      },
      "disclosed": true
    }
  ]
}