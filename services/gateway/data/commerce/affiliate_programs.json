{
  "version": 1,
  "note": "Runtime-loaded per-merchant affiliate program config. Each entry describes HOW to build an affiliate link for a specific merchant or marketplace. Adding a new merchant requires ONLY editing this file — no recompile. All credentials come from ENVIRONMENT VARIABLES (see key_env / param_env), never hardcoded here. A merchant matches when the result URL's host equals or ends with the 'host_suffix' field (label-boundary match, case-insensitive).",
  "programs": [
    {
      "id": "sovrn_commerce",
      "name": "Sovrn Commerce",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 100,
      "template": "https://sovrn.co?key={key}&u={url}",
      "params": {
        "cuid": "{subid}"
      },
      "key_env": "SOVRN_COMMERCE_KEY",
      "param_env": {},
      "bid_floor": "0.10",
      "fallback_url": null,
      "bid_check_url": "https://api.viglink.com/api/bid?key={key}&out={url}",
      "disclosed": true
    },
    {
      "id": "skimlinks",
      "name": "Skimlinks",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 90,
      "template": "https://go.redirectingat.com/?xid={key}&url={url}",
      "params": {},
      "key_env": "SKIMLINKS_XID",
      "param_env": {},
      "disclosed": true
    },
    {
      "id": "ebay_epn",
      "name": "eBay Partner Network",
      "host_suffix": "ebay.",
      "kind": "append_params",
      "enabled": true,
      "priority": 80,
      "template": "{url}",
      "params": {
        "mkevt": "1",
        "mkcid": "1",
        "mkrid": "{key}",
        "campid": "{param:campaign_id}",
        "toolid": "10001",
        "customid": "{subid}"
      },
      "key_env": "EBAY_EPN_ROTATION_ID",
      "param_env": {
        "campaign_id": "EBAY_EPN_CAMPAIGN_ID"
      },
      "disclosed": true
    },
    {
      "id": "amazon_associates",
      "name": "Amazon Associates",
      "host_suffix": "amazon.",
      "kind": "append_params",
      "enabled": true,
      "priority": 70,
      "template": "{url}",
      "params": {
        "tag": "{key}"
      },
      "key_env": "AMAZON_ASSOCIATES_TAG",
      "param_env": {},
      "disclosed": true
    },
    {
      "id": "rakuten_advertising",
      "name": "Rakuten Advertising",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 60,
      "template": "https://click.linksynergy.com/deeplink?id={key}&mid={param:merchant_id}&murl={url}",
      "params": {},
      "key_env": "RAKTUEN_LINKSYNERGY_ID",
      "param_env": {
        "merchant_id": "RAKUTEN_MERCHANT_ID"
      },
      "disclosed": true
    },
    {
      "id": "shareasale",
      "name": "ShareASale",
      "network": "ShareASale",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 50,
      "template": "https://shareasale.com/r.cfm?b={param:affiliate_id}&u={param:merchant_id}&m={param:merchant_id}&urllink={url}",
      "params": {},
      "key_env": "SHAREASALE_AFFILIATE_ID",
      "param_env": {
        "affiliate_id": "SHAREASALE_AFFILIATE_ID",
        "merchant_id": "SHAREASALE_MERCHANT_ID"
      },
      "disclosed": true
    },
    {
      "id": "cj_affiliate",
      "name": "CJ Affiliate",
      "network": "CJ Affiliate",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 45,
      "template": "https://www.dpbolvw.net/click-{}?url={url}",
      "params": {
        "sid": "{subid}"
      },
      "key_env": "CJ_AFFILIATE_PID",
      "param_env": {},
      "disclosed": true
    },
    {
      "id": "awin",
      "name": "Awin",
      "network": "Awin",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 40,
      "template": "https://www.awin1.com/awclick.php?awinmid={param:merchant_id}&awinaffid={key}&clickref={subid}&ued={url}",
      "params": {},
      "key_env": "AWIN_AFFILIATE_ID",
      "param_env": {
        "merchant_id": "AWIN_MERCHANT_ID"
      },
      "disclosed": true
    },
    {
      "id": "impact",
      "name": "Impact",
      "network": "Impact",
      "host_suffix": null,
      "kind": "wrap",
      "enabled": true,
      "priority": 35,
      "template": "https://impact.com/redirect?campaign={param:campaign_id}&key={key}&url={url}&subId={subid}",
      "params": {},
