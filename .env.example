VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
FREE_ONLY=on
OPENVPN_USER=your_protonvpn_username
OPENVPN_PASSWORD=your_protonvpn_password
MAXMIND_LICENSE_KEY=your_maxmind_key

# Comma-separated API keys that unlock the authenticated routes
# (/goals*, /shopping, /commerce/extract). Leave unset to keep them locked.
# The dev stack separately enables the built-in `intentforge-dev-key`
# through INTENTFORGE_DEV_MODE=1 in docker-compose.dev.yml.
INTENTFORGE_API_KEYS=your_api_key_1,your_api_key_2
