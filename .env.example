VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
FREE_ONLY=on
OPENVPN_USER=your_protonvpn_username
OPENVPN_PASSWORD=your_protonvpn_password
MAXMIND_LICENSE_KEY=your_maxmind_key

# Comma-separated API keys that unlock the authenticated routes
# (/goals*, /shopping, /commerce/extract). Leave unset to keep them locked.
# The dev stack separately enables the built-in `intentforge-dev-key`
# through INTENTFORGE_DEV_MODE=1 in docker-compose.dev.yml.
INTENTFORGE_API_KEYS=your_api_key_1,your_api_key_2

# ── Supabase (hosted) — goals persistence + optional Google login ──
# Dev stack uses the in-memory goal store by default; set to `supabase`
# only in prod (or in dev for integration testing).
IF_GOAL_STORE=in_memory

# Dashboard → Project Settings → General. Example: https://abcxyz.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# NEW KEY MODEL (legacy anon/service_role keys are deprecated end of 2026).
# Dashboard → Settings > API Keys → "Publishable and secret API keys" tab.
# Publishable replaces anon: safe in browsers/CLIs, same low privileges, RLS unchanged.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret replaces service_role: servers only, bypasses RLS, 401 from browsers.
# SECRET. Send on the `apikey` header ONLY — never also as Authorization: Bearer.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ── PHASE 2 / DEFERRED — Google OAuth + JWT verification. Do NOT use yet. ──
# New signing-key projects (RS256): https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# Leave SUPABASE_JWT_SECRET blank when using JWKS.
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Legacy (HS256) projects only — Dashboard → Project Settings → API → JWT Settings.
# SECRET. User access tokens are still signed with this unless you migrate to
# rotatable JWT signing keys (a separate, independent migration).
# SUPABASE_JWT_SECRET=

# Sliding expiry for anonymous goals (hours). Any goal request refreshes it;
# rows are deleted on expiry. No claimed/permanent goals until Phase 2.
IF_ANON_GOAL_TTL_HOURS=6

# Optional: same-origin /search URL used when curating goal resources.
# Defaults to http://localhost:4000 (correct for the standard compose network).
# GATEWAY_SELF_URL=http://localhost:4000

# ── LEGACY FALLBACK — only if the project has no new keys yet ──
# Both key types work in parallel: create the new keys in the Dashboard, swap
# callers, verify nothing uses legacy, then deactivate them (reversible).
# The gateway reads these only when the new vars above are unset.
# SUPABASE_ANON_KEY=your_legacy_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key

# NOTE: Google OAuth client ID/secret are NOT gateway env vars. Configure them
# in the Supabase dashboard (Authentication → Providers → Google) with redirect
# URL https://<ref>.supabase.co/auth/v1/callback. The browser signs in through
# Supabase; the gateway only verifies the returned JWT.
