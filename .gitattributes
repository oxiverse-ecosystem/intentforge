* text=auto

# Shell scripts must stay LF — Alpine's ash chokes on CRLF
*.sh text eol=lf

# Docker files are sensitive to line endings too
Dockerfile* text eol=lf
*.dockerfile text eol=lf

# Config files parsed in Linux containers
*.cfg text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Model metadata is checksum-verified by setup.sh against the LF upstream
# blobs; CRLF checkout would fail the SHA and be re-downloaded on every start.
# Upgrade: existing CRLF checkouts may retain their line endings. Back up or
# stash local changes first, then re-check out the tracked model JSON files once
# before restarting (run from the repository root):
# git checkout-index --force -- services/intent-engine/models/*.json
# Otherwise setup.sh may delete the metadata and require a download that can fail.
services/intent-engine/models/*.json text eol=lf

# Binary files
*.mmdb binary
*.tar.gz binary
*.png binary
*.jpg binary
*.ico binary
